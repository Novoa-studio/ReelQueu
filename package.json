{
  "name": "reelqueue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/generate-icons.mjs",
    "db:setup-sql": "node -e \"const fs=require('fs');const files=fs.readdirSync('supabase/migrations').filter(f=>f.endsWith('.sql')).sort();const head=fs.readFileSync('supabase/setup.sql','utf8').split('\\n').slice(0,10).join('\\n');fs.writeFileSync('supabase/setup.sql',head+'\\n'+files.map(f=>'\\n-- >>> supabase/migrations/'+f+'\\n\\n'+fs.readFileSync('supabase/migrations/'+f,'utf8')).join(''))\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
