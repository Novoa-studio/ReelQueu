# Copiez ce fichier en .env.local et renseignez les valeurs de votre projet Supabase
# (Supabase › Project Settings › API, ou variables d'environnement Vercel).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Accepté aussi à la place de la précédente :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
